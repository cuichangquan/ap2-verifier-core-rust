FROM rust:1.90.0-bookworm@sha256:3914072ca0c3b8aad871db9169a651ccfce30cf58303e5d6f2db16d1d8a7e58f
WORKDIR /work
ENV CARGO_BUILD_JOBS=2
COPY Cargo.toml Cargo.lock ./
RUN mkdir src && printf 'pub fn placeholder() {}\n' > src/lib.rs && cargo fetch --locked && rm -rf src
RUN rustup set auto-self-update disable && rustup toolchain install 1.87.0 --profile minimal
