FROM python:3.11.15-slim-bookworm@sha256:d29f48a31a8b408ed19272ca1e7b10ebae13b240a27e862d3d4217c528e2e0c3
WORKDIR /prepare
COPY requirements-oracle.lock ./
RUN python -m pip install --disable-pip-version-check --no-cache-dir --index-url https://pypi.org/simple --only-binary=:all: --require-hashes -r requirements-oracle.lock && python -m pip check
COPY scripts/fetch_official.py ./
RUN python fetch_official.py
ENV PYTHONPATH=/official/code/sdk/python
WORKDIR /work
